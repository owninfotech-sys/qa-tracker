generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  ownedProjects     Project[]          @relation("ProjectOwner")
  assignedItems     RunItem[]          @relation("ItemAssignee")
  assignedFixes     FixTask[]          @relation("FixAssignee")
  assignedPageTasks PageTask[]         @relation("PageTaskAssignee")
  reportedPageTasks PageTask[]         @relation("PageTaskReporter")
  pageTaskComments     PageTaskComment[]
  pageTaskAttachments  PageTaskAttachment[]
  activities           Activity[]

  @@map("qa_user")
}

model Project {
  id        String     @id @default(cuid())
  name      String
  type      String
  url       String?
  rsvpUrl   String?
  status    String     @default("active")
  ownerId   String
  owner     User       @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt DateTime   @default(now())
  modules   Module[]
  pages     Page[]
  cases     TestCase[]
  pageTasks PageTask[]
  runs      TestRun[]

  @@map("qa_project")
}

model Module {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  cases     TestCase[]

  @@map("qa_module")
}

model Page {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  cases     TestCase[]
  tasks     PageTask[]

  @@unique([projectId, name])
  @@map("qa_page")
}

model PageTask {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageId        String
  page          Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  details       String?           @db.Text
  priority      String            @default("P2")
  status        String            @default("open")
  labels        String?
  linkedTaskIds String?
  parentId      String?
  parent        PageTask?         @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      PageTask[]        @relation("TaskTree")
  assigneeId    String?
  assignee      User?             @relation("PageTaskAssignee", fields: [assigneeId], references: [id])
  assigneeIds   String?           @db.Text
  reporterId      String?
  reporter        User?             @relation("PageTaskReporter", fields: [reporterId], references: [id])
  firstResponseAt DateTime?
  resolutionAt    DateTime?
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  comments      PageTaskComment[]
  attachments   PageTaskAttachment[]

  @@map("qa_page_task")
}

model PageTaskComment {
  id           String               @id @default(cuid())
  taskId       String
  task         PageTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  body         String               @db.Text
  visibility   String               @default("internal")
  createdAt    DateTime             @default(now())
  attachments  PageTaskAttachment[]

  @@map("qa_page_task_comment")
}

model PageTaskAttachment {
  id         String            @id @default(cuid())
  taskId     String
  task       PageTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    PageTaskComment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  fileName   String
  mimeType   String
  size       Int
  path       String
  createdAt  DateTime          @default(now())

  @@map("qa_page_task_attachment")
}

model TestCase {
  id            String    @id @default(cuid())
  caseKey       String
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId      String
  module        Module    @relation(fields: [moduleId], references: [id])
  pageId        String?
  page          Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  title         String
  priority      String    @default("P2")
  preconditions String?   @db.Text
  steps         String    @db.Text
  expected      String    @db.Text
  status        String    @default("ready")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  runItems      RunItem[]

  @@unique([projectId, caseKey])
  @@map("qa_test_case")
}

model TestRun {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  build     String?
  dueDate   DateTime?
  status    String    @default("open")
  createdAt DateTime  @default(now())
  items     RunItem[]

  @@map("qa_test_run")
}

model RunItem {
  id           String    @id @default(cuid())
  runId        String
  run          TestRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId       String
  case         TestCase  @relation(fields: [caseId], references: [id])
  assigneeId   String?
  assignee     User?     @relation("ItemAssignee", fields: [assigneeId], references: [id])
  result       String    @default("pending")
  actualResult String?   @db.Text
  comment      String?   @db.Text
  startedAt    DateTime?
  finishedAt   DateTime?
  dueDate      DateTime?
  fixTasks     FixTask[]

  @@map("qa_run_item")
}

model FixTask {
  id         String   @id @default(cuid())
  fixKey     String   @unique
  title      String
  runItemId  String
  runItem    RunItem  @relation(fields: [runItemId], references: [id], onDelete: Cascade)
  severity   String
  assigneeId String?
  assignee   User?    @relation("FixAssignee", fields: [assigneeId], references: [id])
  status     String   @default("open")
  steps      String?  @db.Text
  fixerNotes String?  @db.Text
  dueDate    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("qa_fix_task")
}

model Activity {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@map("qa_activity")
}
